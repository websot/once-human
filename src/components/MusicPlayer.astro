---
import { tracks } from '../data/tracks';
---

<section class="section section--alt music" id="music">
  <div class="container">
    <h2 class="section-title music__title">Музычка</h2>
    <div class="music__divider" aria-hidden="true"></div>

    <div class="player" data-player>
      <audio preload="none"></audio>

      <div class="player__main">
        <img class="player__cover" data-cover src={tracks[0].cover} alt="Обложка трека" width="120" height="120" loading="lazy" />

        <div class="player__info">
          <p class="player__track" data-now-title>{tracks[0].title}</p>

          <div class="player__progress" data-progress role="slider" tabindex="0"
               aria-label="Перемотка" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="player__bar"><div class="player__fill" data-fill></div></div>
          </div>

          <div class="player__controls">
            <button type="button" class="player__btn" data-prev aria-label="Предыдущий трек">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6 6h2v12H6zM18 6l-8.5 6L18 18V6z"/></svg>
            </button>
            <button type="button" class="player__btn player__btn--play" data-play aria-label="Воспроизвести">
              <svg class="icon-play" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              <svg class="icon-pause" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" hidden><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
            </button>
            <button type="button" class="player__btn" data-next aria-label="Следующий трек">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M16 6h2v12h-2zM6 6l8.5 6L6 18V6z"/></svg>
            </button>

            <div class="player__volume">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4z"/></svg>
              <input type="range" min="0" max="100" value="70" data-volume aria-label="Громкость" />
            </div>
          </div>
        </div>
      </div>

      <ol class="player__playlist" data-playlist aria-label="Плейлист">
        {tracks.map((t, i) => (
          <li>
            <button type="button" class:list={['player__item', { 'is-active': i === 0 }]} data-index={i}>
              <span class="player__num">{i + 1}</span>
              <span class="player__name">{t.title}</span>
              <span class="player__tag">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3h-6z"/></svg>
              </span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .music__title {
    margin-bottom: 16px;
  }

  .music__divider {
    height: 2px;
    background: linear-gradient(90deg, var(--accent), transparent);
    border-radius: 2px;
    margin-bottom: 32px;
  }

  .player {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 24px;
    display: grid;
    gap: 24px;
    max-width: 720px;
  }

  .player__main {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .player__cover {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    flex-shrink: 0;
  }

  .player__info {
    flex: 1;
    min-width: 0;
  }

  .player__track {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--white);
    margin: 0 0 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player__progress {
    cursor: pointer;
    padding: 6px 0;
  }

  .player__bar {
    height: 6px;
    background: #ffffff1a;
    border-radius: 3px;
    overflow: hidden;
  }

  .player__fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 3px;
    transition: width 0.2s linear;
  }

  .player__controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .player__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--card-border);
    background: transparent;
    color: var(--text);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .player__btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .player__btn--play {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    width: 48px;
    height: 48px;
  }

  .player__btn--play:hover {
    color: var(--bg);
  }

  .player__volume {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--muted);
  }

  .player__volume input {
    width: 90px;
    accent-color: var(--accent);
  }

  .player__playlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .player__item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 10px 12px;
    color: var(--text);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .player__item:hover {
    background: #ffffff08;
    border-color: var(--card-border);
  }

  .player__item.is-active {
    border-color: var(--accent);
    color: var(--white);
  }

  .player__item.is-active .player__num {
    color: var(--accent);
  }

  .player__num {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    width: 20px;
  }

  .player__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player__tag {
    color: var(--accent);
    display: inline-flex;
  }

  @media (max-width: 767px) {
    .player__main {
      flex-direction: column;
      align-items: stretch;
    }
    .player__cover {
      width: 100%;
      height: 180px;
    }
    .player__volume input {
      width: 64px;
    }
  }
</style>

<script>
  import { tracks } from '../data/tracks';

  const root = document.querySelector<HTMLElement>('[data-player]');
  if (root) {
    const audio = root.querySelector<HTMLAudioElement>('audio')!;
    const cover = root.querySelector<HTMLImageElement>('[data-cover]')!;
    const nowTitle = root.querySelector<HTMLElement>('[data-now-title]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const fill = root.querySelector<HTMLElement>('[data-fill]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const iconPlay = playBtn.querySelector<SVGSVGElement>('.icon-play')!;
    const iconPause = playBtn.querySelector<SVGSVGElement>('.icon-pause')!;
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const volume = root.querySelector<HTMLInputElement>('[data-volume]')!;
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-index]'));

    let current = 0;

    function setTrack(i: number, autoplay = true): void {
      current = (i + tracks.length) % tracks.length;
      audio.src = tracks[current].src;
      cover.src = tracks[current].cover;
      nowTitle.textContent = tracks[current].title;
      items.forEach((el, idx) => el.classList.toggle('is-active', idx === current));
      if (autoplay) void audio.play();
    }

    function updateUI(): void {
      const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
      fill.style.width = `${pct}%`;
      progress.setAttribute('aria-valuenow', String(Math.round(pct)));
    }

    playBtn.addEventListener('click', () => {
      if (!audio.src) setTrack(0, false);
      if (audio.paused) void audio.play(); else audio.pause();
    });

    audio.addEventListener('play', () => {
      iconPlay.hidden = true;
      iconPause.hidden = false;
      playBtn.setAttribute('aria-label', 'Пауза');
    });
    audio.addEventListener('pause', () => {
      iconPlay.hidden = false;
      iconPause.hidden = true;
      playBtn.setAttribute('aria-label', 'Воспроизвести');
    });
    audio.addEventListener('ended', () => setTrack(current + 1, true));
    audio.addEventListener('timeupdate', updateUI);
    audio.addEventListener('loadedmetadata', updateUI);

    prevBtn.addEventListener('click', () => setTrack(current - 1, true));
    nextBtn.addEventListener('click', () => setTrack(current + 1, true));

    items.forEach((el) => {
      el.addEventListener('click', () => setTrack(Number(el.dataset.index), true));
    });

    function seek(clientX: number): void {
      const rect = progress.getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
      if (audio.duration) audio.currentTime = ratio * audio.duration;
      updateUI();
    }

    progress.addEventListener('click', (e) => seek((e as MouseEvent).clientX));
    progress.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (!audio.duration) return;
      if (ev.key === 'ArrowRight') { audio.currentTime += 5; updateUI(); }
      if (ev.key === 'ArrowLeft') { audio.currentTime -= 5; updateUI(); }
    });

    volume.addEventListener('input', () => {
      audio.volume = Number(volume.value) / 100;
    });
    audio.volume = Number(volume.value) / 100;

    setTrack(0, false);
  }
</script>
